__pycache__/
*.pyc
.env
backend/venv/

# data_loader's own on-disk cache - regenerated at process startup, ~650MB+ and
# never survives a Railway redeploy anyway (no persistent volume), so it must
# never be committed. Only the much smaller player_vectors cache is committed.
backend/app/cache/data_loader_cache.pkl
backend/app/cache/data_loader_cache_metadata.json

# large data files - uncompressed CSVs and JSONs (use .gz versions instead)
backend/data/aggregate/all_players.csv
backend/data/player_clusters.csv
backend/data/player_clusters_unified.csv
backend/data/bpm_projections_2027.csv
backend/data/bpm_change_modeling_data.csv
backend/data/players/*-players_enriched.csv
backend/data/players/*-players.csv
backend/data/players/*_torvik.csv
backend/data/teams/*-hoop-explorer-teams.csv
backend/data/games/*.json
backend/data/games/*.db